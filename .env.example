# ==============================================================================
# Lahore City Hub - Production & Development Environment Variable Template
# Copy this file to .env and adjust variables for your specific target environment.
# WARNING: NEVER commit actual secrets, API keys, or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO & APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# In production, generate a secure random 50+ character string using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-a-strong-secret-key-for-production-deployment

# Set to False in ALL production environments!
DJANGO_DEBUG=False

# Comma-separated list of fully qualified domain names and IP addresses
DJANGO_ALLOWED_HOSTS=lahorecityhub.pk,www.lahorecityhub.pk,127.0.0.1,localhost

# Active settings module:
# Development: config.settings.local
# Production:  config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Modern cloud providers (Render, Railway, Heroku, DigitalOcean) supply DATABASE_URL:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:secure_db_password@localhost:5432/lahore_city_hub

# Alternatively, set discrete PostgreSQL parameters if DATABASE_URL is not used:
DB_NAME=lahore_city_hub
DB_USER=postgres
DB_PASSWORD=secure_db_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Development SQLite fallback database file name (only used in local dev)
SQLITE_DB_NAME=db.sqlite3

# ------------------------------------------------------------------------------
# 3. SSL, REVERSE PROXY & SECURITY HEADERS
# ------------------------------------------------------------------------------
# Enforce HTTPS redirect (Set to True in production once TLS/SSL certificate is active)
SECURE_SSL_REDIRECT=True

# Comma-separated list of origins trusted for CSRF POST requests (Django 4.0+)
# Include scheme: https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://lahorecityhub.pk,https://www.lahorecityhub.pk

# ------------------------------------------------------------------------------
# 4. MEDIA FILE STORAGE (User Uploads)
# ------------------------------------------------------------------------------
# Options: 'local' (persistent volume disk) or 's3' (AWS S3 / Cloudflare R2 / DO Spaces)
MEDIA_STORAGE_BACKEND=local

# Optional Cloud Storage Credentials (required only if MEDIA_STORAGE_BACKEND=s3):
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_STORAGE_BUCKET_NAME=lahore-city-hub-media
# AWS_S3_REGION_NAME=ap-south-1
# AWS_S3_CUSTOM_DOMAIN=media.lahorecityhub.pk
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com  # For Cloudflare R2

# ------------------------------------------------------------------------------
# 5. LOGGING & APPLICATION MONITORING
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO
