# ==============================================================================
# Lahore City Hub - Environment Configuration Template
# Copy this file to .env and adjust variables for your local/production environment
# DO NOT COMMIT SENSITIVE SECRETS TO VERSION CONTROL
# ==============================================================================

# Security
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local Development Database (SQLite)
SQLITE_DB_NAME=db.sqlite3

# Production Database (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/lahore_city_hub
DB_NAME=lahore_city_hub
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# Production Security
SECURE_SSL_REDIRECT=False
